# OpenAI API key for AI explanations (optional — falls back to heuristics without it)
OPENAI_API_KEY=sk-your-key-here

# Currents API key for /news page (optional — falls back to BBC/NPR RSS without it)
# Free tier: ~600 requests/day, production-friendly. Sign up at https://currentsapi.services/en/register
CURRENTS_API_KEY=your-currents-api-key
